<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_blue"
    tools:context=".activities.MainActivity">

    <View
        android:id="@+id/rectangle"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:background="@color/dark_blue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/mainText"
        android:textStyle="bold"
        android:textColor="@color/yellow"
        android:textSize="30sp"
        app:layout_constraintBottom_toBottomOf="@id/rectangle"
        app:layout_constraintEnd_toEndOf="@id/rectangle"
        app:layout_constraintStart_toStartOf="@id/rectangle"
        app:layout_constraintTop_toTopOf="@id/rectangle" />


    <com.google.android.material.button.MaterialButton
        android:id="@+id/scanButton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/scanButton"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:backgroundTint="@color/field_blue"
        app:layout_constraintBottom_toTopOf="@id/productsButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rectangle"
        app:layout_constraintVertical_chainStyle="spread"
        app:layout_constraintVertical_weight="1"
        app:strokeColor="@color/yellow"
        app:strokeWidth="2dp"
        app:cornerRadius="1000dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/productsButton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:textStyle="bold"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/documentBtn"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:backgroundTint="@color/field_blue"
        app:layout_constraintBottom_toTopOf="@id/documentButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scanButton"
        app:layout_constraintVertical_weight="1"
        app:strokeColor="@color/yellow"
        app:strokeWidth="2dp"
        app:cornerRadius="1000dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/documentButton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:textStyle="bold"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/productsButton"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:backgroundTint="@color/field_blue"
        app:layout_constraintBottom_toTopOf="@id/incomingSgpButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/productsButton"
        app:layout_constraintVertical_weight="1"
        app:strokeColor="@color/yellow"
        app:strokeWidth="2dp"
        app:cornerRadius="1000dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/incomingSgpButton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:textStyle="bold"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/incomingSgpButton"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:backgroundTint="@color/field_blue"
        app:layout_constraintBottom_toTopOf="@id/logoutButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/documentButton"
        app:layout_constraintVertical_weight="1"
        app:strokeColor="@color/yellow"
        app:strokeWidth="2dp"
        app:cornerRadius="1000dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/logoutButton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:text="@string/logoutButton"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="20sp"
        app:backgroundTint="@color/field_blue"
        app:layout_constraintBottom_toTopOf="@id/regiusLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/incomingSgpButton"
        app:layout_constraintVertical_weight="1"
        app:strokeColor="@color/yellow"
        app:strokeWidth="2dp"
        app:cornerRadius="1000dp"/>

    <TextView
        android:id="@+id/regiusLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Powered By RegiusLab"
        android:textColor="@color/gray"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>