<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="false"
    android:overScrollMode="ifContentScrolls"
    android:scrollbars="vertical"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/comingProductCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/coming_card_padding_horizontal"
        android:paddingVertical="@dimen/coming_card_padding_vertical"
        android:background="@drawable/item_yellow_border_dark_bg"
        android:layout_marginBottom="@dimen/coming_card_margin_bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/coming_field_min_height"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvProductName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Товар1"
                android:textSize="@dimen/coming_product_name_text"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:maxLines="3"
                android:ellipsize="end"
                android:clickable="false"
                android:focusable="false"
                android:focusableInTouchMode="false"/>

            <ImageButton
                android:id="@+id/btnCopy"
                android:layout_width="@dimen/coming_action_button_size"
                android:layout_height="@dimen/coming_action_button_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/coming_action_button_padding"
                app:srcCompat="@drawable/abc_ic_menu_copy_mtrl_am_alpha"
                app:tint="@color/yellow"
                tools:ignore="ContentDescription" />

            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="@dimen/coming_action_button_size"
                android:layout_height="@dimen/coming_action_button_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/coming_action_button_padding"
                app:srcCompat="@drawable/ic_delete_red"
                app:tint="@color/holo_red_dark"
                tools:ignore="ContentDescription" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/coming_field_min_height"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/coming_row_margin_top">

            <EditText
                android:id="@+id/etQuantity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/coming_field_min_height"
                android:layout_weight="1"
                android:inputType="number"
                android:hint="Количество"
                android:textColor="@color/white"
                android:textColorHint="@color/hint_white"
                android:textSize="@dimen/coming_field_text"
                android:gravity="center"
                android:background="@drawable/input_field_yellow_border_blue_bg"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="8dp" />

            <Spinner
                android:id="@+id/spinnerMeasure"
                android:layout_width="0dp"
                android:layout_height="@dimen/coming_field_min_height"
                android:layout_weight="1"
                android:background="@drawable/input_field_yellow_border_blue_bg"
                android:paddingHorizontal="12dp"
                android:textAlignment="center" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/coming_field_min_height"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/coming_row_margin_top">

            <EditText
                android:id="@+id/etDiameter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/coming_field_min_height"
                android:layout_weight="1"
                android:inputType="numberDecimal"
                android:hint="Диаметр"
                android:textColor="@color/white"
                android:textColorHint="@color/hint_white"
                android:textSize="@dimen/coming_field_text"
                android:gravity="center"
                android:background="@drawable/input_field_yellow_border_blue_bg"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/etWeight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/coming_field_min_height"
                android:layout_weight="1"
                android:inputType="numberDecimal"
                android:hint="Вес"
                android:textColor="@color/white"
                android:textColorHint="@color/hint_white"
                android:textSize="@dimen/coming_field_text"
                android:gravity="center"
                android:background="@drawable/input_field_yellow_border_blue_bg"
                android:paddingHorizontal="12dp" />
        </LinearLayout>

        <EditText
            android:id="@+id/etWallThickness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/coming_field_min_height"
            android:layout_marginTop="@dimen/coming_row_margin_top"
            android:inputType="numberDecimal"
            android:hint="Толщина стенки"
            android:textColor="@color/white"
            android:textColorHint="@color/hint_white"
            android:textSize="@dimen/coming_field_text"
            android:gravity="center"
            android:background="@drawable/input_field_yellow_border_blue_bg"
            android:paddingHorizontal="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/coming_field_min_height"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/coming_row_margin_top">

            <EditText
                android:id="@+id/etBatchNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/coming_field_min_height"
                android:layout_weight="1"
                android:hint="Партия"
                android:textSize="@dimen/coming_field_text"
                android:textColor="@color/white"
                android:textColorHint="@color/hint_white"
                android:background="@drawable/input_field_yellow_border_blue_bg"
                android:paddingHorizontal="12dp"
                tools:ignore="Autofill,TextFields" />

            <CheckBox
                android:id="@+id/cbOldProduct"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/coming_field_min_height"
                android:layout_weight="1"
                android:text="Старая продукция"
                android:textColor="@color/white"
                android:buttonTint="@color/yellow"
                android:gravity="center_vertical" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/barcodeSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/coming_field_min_height"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/coming_row_margin_top"
            android:layout_marginBottom="@dimen/coming_barcode_section_margin_bottom">

            <EditText
                android:id="@+id/tvBarcode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/coming_field_min_height"
                android:hint="Штрихкод"
                android:textSize="@dimen/coming_field_text"
                android:textColor="@color/white"
                android:textColorHint="@color/hint_white"
                android:background="@drawable/input_field_yellow_border_blue_bg"
                android:paddingHorizontal="12dp"
                tools:ignore="Autofill,TextFields" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBarcodeError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Заполните штрихкод"
            android:textColor="@android:color/holo_red_light"
            android:textSize="12sp"
            android:paddingTop="2dp"
            android:paddingBottom="4dp"
            android:visibility="gone"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
