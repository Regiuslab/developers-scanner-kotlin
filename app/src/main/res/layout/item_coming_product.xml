<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:background="@drawable/item_yellow_border_dark_bg"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvProductName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Товар1"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:maxLines="4"
                android:ellipsize="end"
                android:clickable="false"
                android:focusable="false"
                android:focusableInTouchMode="false"/>

            <ImageButton
                android:id="@+id/btnCopy"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                app:srcCompat="@drawable/abc_ic_menu_copy_mtrl_am_alpha"
                app:tint="@color/yellow"
                tools:ignore="ContentDescription" />

            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                app:srcCompat="@drawable/ic_delete_red"
                app:tint="@color/holo_red_dark"
                tools:ignore="ContentDescription" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <EditText
                android:id="@+id/etQuantity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:inputType="number"
                android:hint="Количество"
                android:textColor="@color/white"
                android:textColorHint="@color/hint_white"
                android:textSize="16sp"
                android:gravity="center"
                android:background="@drawable/input_field_yellow_border_blue_bg"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="10dp" />

            <Spinner
                android:id="@+id/spinnerMeasure"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/input_field_yellow_border_blue_bg"
                android:paddingHorizontal="12dp"
                android:textAlignment="center" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <EditText
                android:id="@+id/etDiameter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:inputType="numberDecimal"
                android:hint="Диаметр"
                android:textColor="@color/white"
                android:textColorHint="@color/hint_white"
                android:textSize="16sp"
                android:gravity="center"
                android:background="@drawable/input_field_yellow_border_blue_bg"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="10dp" />

            <EditText
                android:id="@+id/etWeight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:inputType="numberDecimal"
                android:hint="Вес"
                android:textColor="@color/white"
                android:textColorHint="@color/hint_white"
                android:textSize="16sp"
                android:gravity="center"
                android:background="@drawable/input_field_yellow_border_blue_bg"
                android:paddingHorizontal="12dp" />
        </LinearLayout>

        <EditText
            android:id="@+id/etWallThickness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="6dp"
            android:inputType="numberDecimal"
            android:hint="Толщина стенки"
            android:textColor="@color/white"
            android:textColorHint="@color/hint_white"
            android:textSize="16sp"
            android:gravity="center"
            android:background="@drawable/input_field_yellow_border_blue_bg"
            android:paddingHorizontal="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <EditText
                android:id="@+id/etBatchNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:hint="Партия"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:textColorHint="@color/hint_white"
                android:background="@drawable/input_field_yellow_border_blue_bg"
                android:paddingHorizontal="12dp"
                tools:ignore="Autofill,TextFields" />

            <CheckBox
                android:id="@+id/cbOldProduct"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:text="Старая продукция"
                android:textColor="@color/white"
                android:buttonTint="@color/yellow"
                android:gravity="center_vertical" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/barcodeSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="4dp">

            <EditText
                android:id="@+id/tvBarcode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:hint="Штрихкод"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:textColorHint="@color/hint_white"
                android:background="@drawable/input_field_yellow_border_blue_bg"
                android:paddingHorizontal="12dp"
                tools:ignore="Autofill,TextFields" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBarcodeError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Заполните штрихкод"
            android:textColor="@android:color/holo_red_light"
            android:textSize="12sp"
            android:paddingTop="2dp"
            android:paddingBottom="8dp"
            android:visibility="gone"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
