<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/comingProductsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/dark_blue"
    android:padding="@dimen/coming_screen_padding">


    <LinearLayout
        android:id="@+id/topSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/mainTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:text="@string/documentComingType"
            android:textColor="@color/white"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/coming_header_margin_top">

            <TextView
                android:id="@+id/tvArrivalNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="@color/yellow"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/tvArrivalDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:singleLine="true"
                android:textColor="@color/gray"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>


    <TextView
        android:id="@+id/emptyProductListTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Список товаров пуст"
        android:textColor="@color/light_gray"
        android:textSize="18sp"
        android:gravity="center"
        android:visibility="gone"
        android:layout_centerInParent="true"/>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvProducts"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topSection"
        android:layout_above="@id/buttonContainer"
        android:layout_marginTop="@dimen/coming_rv_margin_top"
        android:layout_marginBottom="@dimen/coming_rv_margin_bottom"
        android:clipToPadding="true"
        android:overScrollMode="never"/>


    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_centerInParent="true"/>


    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="@dimen/coming_button_bar_margin_top">

        <Button
            android:id="@+id/btnAddProduct"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minHeight="@dimen/coming_button_min_height"
            android:backgroundTint="@color/field_blue"
            android:text="@string/btnAddProduct"
            android:textColor="@color/white"
            tools:ignore="ButtonStyle"
            app:strokeColor="@color/yellow"
            app:strokeWidth="1.5dp"
            app:cornerRadius="16dp"/>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:minHeight="@dimen/coming_button_min_height"
            android:backgroundTint="@color/surface_elevated"
            android:text="@string/btnSave"
            android:textColor="@color/white"
            tools:ignore="ButtonStyle"
            app:strokeColor="@color/stroke_muted"
            app:strokeWidth="1.5dp"
            app:cornerRadius="16dp"/>
    </LinearLayout>

</RelativeLayout>
