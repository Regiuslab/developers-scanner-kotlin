<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/field_blue"/>
            <corners android:radius="12dp"/>

            <stroke android:width="2.5dp" android:color="@color/glowing_yellow"/>
            <padding
                android:left="10dp"
                android:right="10dp"
                android:top="8dp"
                android:bottom="8dp"/>
        </shape>
    </item>


    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/field_blue"/>
            <corners android:radius="12dp"/>
            <stroke android:width="1dp" android:color="@color/yellow"/>
            <padding
                android:left="10dp"
                android:right="10dp"
                android:top="8dp"
                android:bottom="8dp"/>
        </shape>
    </item>
</selector>